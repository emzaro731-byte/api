# Free/open-source local mode
AI_PROVIDER=local
AI_MODEL=llama3.2
LOCAL_AI_URL=http://127.0.0.1:11434/v1

# Optional hosted providers (not needed for local chat)
OPENAI_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.7
VEYLOLA_API_KEY=
RATE_LIMIT_PER_MINUTE=0

# Optional external music provider
MUSIC_API_URL=
MUSIC_API_KEY=

# Optional local media adapters. Each endpoint should accept JSON and return JSON.
LOCAL_IMAGE_URL=
LOCAL_VIDEO_URL=
LOCAL_MUSIC_URL=
